<phone:PhoneApplicationPage
    x:Class="ArtHub.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    Background="{StaticResource PageBg}">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.Resources>
        <DataTemplate x:Key="SourceRow">
            <Grid Margin="0,0,0,20" Background="Transparent" Tap="Row_Tap">
                <!-- удержание: системное меню edit / delete (в режиме выбора источника отключено).
                     IsZoomEnabled=False — страница не отъезжает назад, BorderThickness=0 — без рамки -->
                <toolkit:ContextMenuService.ContextMenu>
                    <toolkit:ContextMenu IsEnabled="{Binding ShowTools}"
                                         IsZoomEnabled="False" BorderThickness="0"
                                         Closed="Menu_Closed">
                        <toolkit:MenuItem Header="edit" Click="Edit_Click"/>
                        <toolkit:MenuItem Header="delete" Click="Delete_Click"/>
                    </toolkit:ContextMenu>
                </toolkit:ContextMenuService.ContextMenu>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="32" TextTrimming="WordEllipsis"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="{Binding Url}" FontSize="20" TextTrimming="WordEllipsis"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBg}" Padding="12,6,12,10">
            <StackPanel>
                <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                       HorizontalAlignment="Left"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="40"
                           FontFamily="Segoe WP Light"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,24,24,36">
                <ItemsControl x:Name="SourceList" ItemTemplate="{StaticResource SourceRow}"/>

                <!-- системная кнопка на всю ширину, рамка и текст цвета шапки (как show tags) -->
                <Button x:Name="AddRow" Content="add source" Click="Add_Click"
                        Margin="-12,12,-12,0" HorizontalAlignment="Stretch"
                        Foreground="{StaticResource HeaderBg}"
                        BorderBrush="{StaticResource HeaderBg}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>