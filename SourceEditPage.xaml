<phone:PhoneApplicationPage
    x:Class="ArtHub.SourceEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    Background="{StaticResource PageBg}">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBg}" Padding="12,6,12,10">
            <StackPanel Margin="0,4,0,0">
                <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="40"
                           FontFamily="Segoe WP Light"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,18,24,36">
                <TextBlock Text="name" FontSize="20"
                           Foreground="{StaticResource TextDim}"/>
                <TextBox x:Name="NameBox" FontSize="22"/>

                <TextBlock Text="address" FontSize="20"
                           Foreground="{StaticResource TextDim}"/>
                <TextBox x:Name="UrlBox" FontSize="22">
                    <TextBox.InputScope>
                        <InputScope>
                            <InputScopeName NameValue="Url"/>
                        </InputScope>
                    </TextBox.InputScope>
                </TextBox>

                <TextBlock Text="api key (optional)" FontSize="20"
                           Foreground="{StaticResource TextDim}"/>
                <TextBox x:Name="KeyBox" FontSize="22"/>

                <TextBlock Text="user id (optional)" FontSize="20"
                           Foreground="{StaticResource TextDim}"/>
                <TextBox x:Name="UserBox" FontSize="22"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="save" Click="Save_Click"
                            Foreground="{StaticResource TextDark}"
                            BorderBrush="{StaticResource TextDark}"/>
                    <Button Grid.Column="1" Content="cancel" Click="Cancel_Click"
                            Foreground="{StaticResource TextDark}"
                            BorderBrush="{StaticResource TextDark}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>