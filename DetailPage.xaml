<phone:PhoneApplicationPage
    x:Class="ArtHub.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    shell:SystemTray.Opacity="0.99"
    Background="{StaticResource PageBg}">
    <!-- Opacity 0.99: страница лежит под панелью с часами, поэтому при смене её прозрачности
         в просмотре картинки ничего не прыгает. Шапка тянется под панель (строки 0 и 1) -->

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.ApplicationBar>
        <!-- Opacity 0.99: страница идёт под панелью (нет чёрной полоски, и при смене панели
             в просмотре картинки ничего не прыгает). Место под панель — нижний отступ 96 у содержимого -->
        <shell:ApplicationBar Mode="Default" Opacity="0.99"
                              BackgroundColor="#FF4E6252" ForegroundColor="White">
            <shell:ApplicationBarIconButton IconUri="/Assets/Icons/star.png"
                                            Text="favourite" Click="Fav_Click"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/Icons/save.png"
                                            Text="download" Click="Download_Click"/>
            <shell:ApplicationBarIconButton IconUri="/Assets/Icons/site.png"
                                            Text="open site" Click="Open_Click"/>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <toolkit:GestureService.GestureListener>
            <toolkit:GestureListener DragStarted="Drag_Started"
                                     DragDelta="Drag_Delta"
                                     DragCompleted="Drag_Completed"/>
        </toolkit:GestureService.GestureListener>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- шапка начинается от самого верха экрана: под панелью с часами нет просвета -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource HeaderBg}" Padding="12,38,12,10">
            <StackPanel>
                <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                       HorizontalAlignment="Left"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="40"
                           FontFamily="Segoe WP Light"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="DetailScroll" Grid.Row="2">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="SlideT"/>
            </ScrollViewer.RenderTransform>

            <!-- снизу 96 = 72 (высота панели с кнопками) + 24: последние теги не прячутся под панель -->
            <StackPanel Margin="12,12,12,240">

                <Grid x:Name="MediaHost">
                    <Image x:Name="MainImage" Stretch="Uniform" Tap="MainImage_Tap"/>

                    <!-- значок воспроизведения для GIF и видео -->
                    <Grid x:Name="PlayMark" Width="96" Height="96" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse Fill="#99000000" Stroke="White" StrokeThickness="3"/>
                        <TextBlock Text="▶" FontSize="44" Foreground="White"
                                   FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <phone:WebBrowser x:Name="GifBrowser" Visibility="Collapsed"
                                      Background="Black"/>
                </Grid>

                <TextBlock x:Name="InfoText" FontSize="20" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}" Margin="0,12,0,0"/>

                <!-- show tags / hide tags: системная кнопка, рамка и текст цвета шапки -->
                <Button x:Name="TagsButton" Content="show tags" Click="TagsButton_Click"
                        Margin="-12,12,-12,0" HorizontalAlignment="Stretch"
                        Foreground="{StaticResource HeaderBg}"
                        BorderBrush="{StaticResource HeaderBg}"/>

                <TextBlock x:Name="TagsStatus" Text="loading tags..." FontSize="20"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{StaticResource TextDim}" Margin="0,12,0,0"/>
                <StackPanel x:Name="TagsPanel" Margin="0,0,0,12" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- просмотр картинки поверх всего -->
        <Grid x:Name="ZoomOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#80000000"
              ManipulationStarted="Zoom_ManipulationStarted"
              ManipulationDelta="Zoom_ManipulationDelta"
              ManipulationCompleted="Zoom_ManipulationCompleted">

            <Grid x:Name="ZoomArea" Background="Transparent">
                <toolkit:GestureService.GestureListener>
                    <toolkit:GestureListener DoubleTap="Zoom_DoubleTap"/>
                </toolkit:GestureService.GestureListener>

                <!-- IsHitTestVisible=False: жест ловит ZoomArea, координаты не зависят от масштаба -->
                <Image x:Name="ZoomImage" Stretch="Uniform" IsHitTestVisible="False"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="ZoomTransform"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <!-- кнопка close теперь на нижней полупрозрачной панели (создаётся в коде) -->
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>