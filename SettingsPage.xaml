<phone:PhoneApplicationPage
    x:Class="ArtHub.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    Background="{StaticResource PageBg}">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBg}" Padding="12,6,12,10">
            <StackPanel>
                <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                       HorizontalAlignment="Left"/>
                <TextBlock Text="settings" Foreground="White" FontSize="40"
                           FontFamily="Segoe WP Light"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,120">

                <!-- sources -->
                <StackPanel Background="Transparent" Tap="Sources_Tap" Margin="0,0,0,36">
                    <TextBlock Text="sources" FontSize="34"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="SourceName" FontSize="20" TextWrapping="Wrap"
                               Foreground="{StaticResource HeaderBg}"/>
                </StackPanel>

                <!-- blacklist -->
                <StackPanel Background="Transparent" Tap="Blacklist_Tap" Margin="0,0,0,36">
                    <TextBlock Text="blacklist" FontSize="34"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock x:Name="BlacklistInfo" FontSize="20" TextWrapping="Wrap"
                               Foreground="{StaticResource HeaderBg}"/>
                </StackPanel>

                <!-- AI filter -->
                <toolkit:ToggleSwitch x:Name="HideAiSwitch"
                                      Background="{StaticResource PageBg}"
                                      Foreground="{StaticResource HeaderBg}"
                                      SwitchForeground="{StaticResource HeaderBg}"
                                      Margin="-12,0,0,0"
                                      Checked="Switch_Changed" Unchecked="Switch_Changed">
                    <toolkit:ToggleSwitch.Header>
                        <TextBlock Text="hide AI-generated posts" FontSize="20"
                                   Foreground="{StaticResource TextDark}"/>
                    </toolkit:ToggleSwitch.Header>
                </toolkit:ToggleSwitch>
                <TextBlock Text="Hide posts tagged as AI-generated or AI-assisted."
                           FontSize="20" TextWrapping="Wrap" Margin="0,-20,0,36"
                           Foreground="{StaticResource HeaderBg}"/>

                <!-- thumbnails quality -->
                <toolkit:ToggleSwitch x:Name="HqSwitch"
                                      Background="{StaticResource PageBg}"
                                      Foreground="{StaticResource HeaderBg}"
                                      SwitchForeground="{StaticResource HeaderBg}"
                                      Margin="-12,0,0,0"
                                      Checked="Switch_Changed" Unchecked="Switch_Changed">
                    <toolkit:ToggleSwitch.Header>
                        <TextBlock Text="high-quality thumbnails" FontSize="20"
                                   Foreground="{StaticResource TextDark}"/>
                    </toolkit:ToggleSwitch.Header>
                </toolkit:ToggleSwitch>
                <TextBlock Text="Load larger previews in the grid. Looks better, but loads and opens more slowly."
                           FontSize="20" TextWrapping="Wrap" Margin="0,-20,0,36"
                           Foreground="{StaticResource HeaderBg}"/>

                <!-- tile appearance -->
                <toolkit:ListPicker x:Name="TilePicker"
                    Margin="-12,0,0,36"
                    Foreground="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource HeaderBg}" Background="Transparent"
                    SelectionChanged="Tile_Changed" Width="420">
                    <toolkit:ListPicker.Header>
                        <TextBlock Text="tile appearance" FontSize="20"
                                   Foreground="{StaticResource HeaderBg}"/>
                    </toolkit:ListPicker.Header>
                </toolkit:ListPicker>

                <!-- grid columns -->
                <toolkit:ListPicker x:Name="GridPicker"
                    Margin="-12,0,0,0"
                    Foreground="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource HeaderBg}" Background="Transparent"
                    SelectionChanged="Grid_Changed" Width="420">
                    <toolkit:ListPicker.Header>
                        <TextBlock Text="grid size" FontSize="20"
                                   Foreground="{StaticResource HeaderBg}"/>
                    </toolkit:ListPicker.Header>
                </toolkit:ListPicker>

                <!-- о программе: большой логотип по центру, название с версией, описание, автор -->
                <StackPanel Margin="0,60,0,0" HorizontalAlignment="Center">
                    <!-- пасхалка: 5 нажатий подряд -->
                    <Image Source="/Assets/about.png" Width="300" Stretch="Uniform"
                           HorizontalAlignment="Center" Tap="AboutLogo_Tap"/>
                    <TextBlock x:Name="AboutTitle" FontSize="28" FontFamily="Segoe WP Light"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock Text="A Booru viewer for sites built on and powered by Gelbooru for Windows Phone 8.0+"
                               FontSize="20" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextDim}"/>
                    <TextBlock Text="created by Bebber" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>