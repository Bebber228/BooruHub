<phone:PhoneApplicationPage
    x:Class="ArtHub.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:local="clr-namespace:ArtHub"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    Background="{StaticResource PageBg}">

    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.Resources>
        <local:ImageConverter x:Key="Img"/>

        <DataTemplate x:Key="GridItem">
            <Grid Margin="2">
                <Border Background="{StaticResource CardBg}">
                    <Image Source="{Binding ImageUrl, Converter={StaticResource Img}, ConverterParameter=240}"
                           Stretch="UniformToFill"/>
                </Border>
                <Border BorderBrush="#FF1E6FE0" BorderThickness="3"
                        IsHitTestVisible="False" Visibility="{Binding MediaVisible}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuggestItem">
            <TextBlock Text="{Binding Label}" FontSize="26" Margin="12,6"
                       Foreground="{StaticResource TextDark}"/>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar Mode="Minimized"
                              BackgroundColor="#FF4E6252" ForegroundColor="White">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="refresh" Click="Refresh_Click"/>
                <shell:ApplicationBarMenuItem Text="clear search" Click="ClearSearch_Click"/>
                <shell:ApplicationBarMenuItem Text="switch source" Click="SwitchSource_Click"/>
                <shell:ApplicationBarMenuItem Text="settings" Click="Settings_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" VerticalAlignment="Top" Height="158"
                   Fill="{StaticResource HeaderBg}"/>

        <Grid Grid.Row="0" Height="48" Margin="12,6,12,0">
            <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="SourceText" Foreground="White" FontSize="20"
                       FontFamily="Segoe WP Semibold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <phone:Pivot x:Name="MainPivot" Grid.Row="1" Margin="0,-12,0,0"
                     Foreground="White" Background="Transparent"
                     SelectedIndex="1" Loaded="MainPivot_Loaded">
            <phone:Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="64" FontFamily="Segoe WP Light"/>
                </DataTemplate>
            </phone:Pivot.HeaderTemplate>

            <!-- search -->
            <phone:PivotItem x:Name="SearchItem" Header="search" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,36,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" FontSize="24"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyUp="SearchBox_KeyUp">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScopeName NameValue="Search"/>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <Button Grid.Column="1" Content="search" Click="Search_Click"
                                Foreground="{StaticResource TextDark}"
                                BorderBrush="{StaticResource TextDark}"/>
                    </Grid>

                    <ListBox x:Name="Suggestions" Grid.Row="1" Visibility="Collapsed"
                             Margin="12,0,12,0"
                             Background="{StaticResource CardBg}"
                             ItemTemplate="{StaticResource SuggestItem}"
                             SelectionChanged="Suggestions_SelectionChanged"/>
                </Grid>
            </phone:PivotItem>

            <!-- posts -->
            <phone:PivotItem x:Name="PostsItem" Header="posts" Margin="0,20,0,0">
                <phone:LongListSelector x:Name="PostsList"
                                        LayoutMode="Grid"
                                        Margin="6,0"
                                        ItemTemplate="{StaticResource GridItem}"
                                        SelectionChanged="List_SelectionChanged">
                    <phone:LongListSelector.ListHeader>
                        <Border Height="16"/>
                    </phone:LongListSelector.ListHeader>

                    <phone:LongListSelector.ListFooter>
                        <StackPanel x:Name="PagerRoot" Margin="0,12,0,36" Visibility="Collapsed">
                            <!-- номера страниц -->
                            <Grid x:Name="PagerGrid"/>

                            <!-- << < > >> -->
                            <Grid x:Name="NavGrid" Margin="0,2,0,0"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="PageBox" FontSize="22">
                                    <TextBox.InputScope>
                                        <InputScope>
                                            <InputScopeName NameValue="Number"/>
                                        </InputScope>
                                    </TextBox.InputScope>
                                </TextBox>

                                <Button Grid.Column="1" Content="go to" Click="Go_Click"
                                        Foreground="{StaticResource TextDark}"
                                        BorderBrush="{StaticResource TextDark}"/>
                            </Grid>
                        </StackPanel>
                    </phone:LongListSelector.ListFooter>
                </phone:LongListSelector>
            </phone:PivotItem>

            <!-- favourites -->
            <phone:PivotItem x:Name="FavItem" Header="favourites" Margin="0,8,0,0">
                <Grid>
                    <phone:LongListSelector x:Name="FavList"
                                            LayoutMode="Grid"
                                            Margin="6,10,6,0"
                                            ItemTemplate="{StaticResource GridItem}"
                                            SelectionChanged="List_SelectionChanged">
                        <phone:LongListSelector.ListHeader>
                            <Border Height="16"/>
                        </phone:LongListSelector.ListHeader>
                    </phone:LongListSelector>

                    <!-- заглушка, когда избранное пустое -->
                    <StackPanel x:Name="FavEmpty" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="40,0,40,60" IsHitTestVisible="False">
                        <Image Source="/Assets/Icons/image_multiple.png"
                               Width="120" Height="120" Stretch="Uniform"/>
                        <TextBlock Text="Your liked photos will be stored here"
                                   FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Grid>
            </phone:PivotItem>
        </phone:Pivot>
    </Grid>
</phone:PhoneApplicationPage>