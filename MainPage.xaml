<phone:PhoneApplicationPage
    x:Class="ArtHub.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:local="clr-namespace:ArtHub"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
    shell:SystemTray.BackgroundColor="#FF4E6252"
    shell:SystemTray.ForegroundColor="White"
    Background="{StaticResource PageBg}">


    <toolkit:TransitionService.NavigationInTransition>
        <toolkit:NavigationInTransition>
            <toolkit:NavigationInTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardIn"/>
            </toolkit:NavigationInTransition.Backward>
            <toolkit:NavigationInTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardIn"/>
            </toolkit:NavigationInTransition.Forward>
        </toolkit:NavigationInTransition>
    </toolkit:TransitionService.NavigationInTransition>
    <toolkit:TransitionService.NavigationOutTransition>
        <toolkit:NavigationOutTransition>
            <toolkit:NavigationOutTransition.Backward>
                <toolkit:TurnstileTransition Mode="BackwardOut"/>
            </toolkit:NavigationOutTransition.Backward>
            <toolkit:NavigationOutTransition.Forward>
                <toolkit:TurnstileTransition Mode="ForwardOut"/>
            </toolkit:NavigationOutTransition.Forward>
        </toolkit:NavigationOutTransition>
    </toolkit:TransitionService.NavigationOutTransition>

    <phone:PhoneApplicationPage.Resources>
        <local:ImageConverter x:Key="Img"/>

        <!-- плитка: размер задаётся в коде -->
        <DataTemplate x:Key="GridItem">
            <Grid Loaded="Tile_Loaded" Tap="Tile_Tap" Background="Transparent">
                <Border Margin="2" Background="{StaticResource CardBg}">
                    <Image Source="{Binding ImageUrl, Converter={StaticResource Img}, ConverterParameter=200}"
                           Stretch="UniformToFill"/>
                </Border>
                <Border Margin="2" BorderBrush="#FF1E6FE0" BorderThickness="3"
                        IsHitTestVisible="False" Visibility="{Binding MediaVisible}"/>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <toolkit:WrapPanel/>
        </ItemsPanelTemplate>

        <!-- круглая кнопка как на нижней панели, в цвете шапки; при нажатии круг заливается -->
        <Style x:Key="SearchRoundButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="76" Height="76" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Circle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeaderBg}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PageBg}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity" To="0.4"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Ellipse x:Name="Circle" Width="48" Height="48" Fill="Transparent"
                                     Stroke="{StaticResource HeaderBg}" StrokeThickness="3"/>
                            <!-- иконка красится в цвет шапки через маску -->
                            <Rectangle x:Name="Glyph" Fill="{StaticResource HeaderBg}"
                                       Width="46" Height="46">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/magnify.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- такая же круглая кнопка для перехода на страницу -->
        <Style x:Key="PageRoundButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="76" Height="76" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Circle"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HeaderBg}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph"
                                                                           Storyboard.TargetProperty="Fill">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PageBg}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Duration="0" Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity" To="0.4"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Ellipse x:Name="Circle" Width="48" Height="48" Fill="Transparent"
                                     Stroke="{StaticResource HeaderBg}" StrokeThickness="3"/>
                            <!-- иконка красится в цвет шапки через маску -->
                            <Rectangle x:Name="Glyph" Fill="{StaticResource HeaderBg}"
                                       Width="46" Height="46">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Assets/Icons/page_arrow_color.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestItem">
            <TextBlock Text="{Binding Label}" FontSize="26" Margin="12,6"
                       Foreground="{StaticResource TextDark}"/>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar Mode="Minimized"
                              BackgroundColor="#FF4E6252" ForegroundColor="White">
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem Text="refresh" Click="Refresh_Click"/>
                <shell:ApplicationBarMenuItem Text="clear search" Click="ClearSearch_Click"/>
                <shell:ApplicationBarMenuItem Text="switch source" Click="SwitchSource_Click"/>
                <!-- текст меняется в коде: blacklist: on / blacklist: off -->
                <shell:ApplicationBarMenuItem Text="blacklist: on" Click="Blacklist_Click"/>
                <shell:ApplicationBarMenuItem Text="settings" Click="Settings_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>

    <Grid x:Name="LayoutRoot" Background="{StaticResource PageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" VerticalAlignment="Top" Height="158"
                   Fill="{StaticResource HeaderBg}"/>

        <!-- своя полоса загрузки цвета фона приложения (системные точки всегда цвета акцента) -->
        <ProgressBar x:Name="LoadBar" Grid.Row="0" VerticalAlignment="Top"
                     IsIndeterminate="False" Visibility="Collapsed"
                     Foreground="{StaticResource PageBg}" Background="Transparent"/>

        <Grid Grid.Row="0" Height="48" Margin="12,6,12,0">
            <Image Source="/Assets/logo.png" Height="32" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="SourceText" Foreground="White" FontSize="20"
                       FontFamily="Segoe WP Semibold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <phone:Pivot x:Name="MainPivot" Grid.Row="1" Margin="0,-12,0,0"
                     Foreground="White" Background="Transparent"
                     SelectedIndex="1">
            <phone:Pivot.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="64" FontFamily="Segoe WP Light"/>
                </DataTemplate>
            </phone:Pivot.HeaderTemplate>

            <!-- search -->
            <phone:PivotItem x:Name="SearchItem" Header="search" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,36,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" FontSize="24"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyUp="SearchBox_KeyUp">
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScopeName NameValue="Search"/>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource SearchRoundButton}"
                                Click="Search_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <ListBox x:Name="Suggestions" Grid.Row="1" Visibility="Collapsed"
                             Margin="12,0,12,0"
                             Background="{StaticResource CardBg}"
                             ItemTemplate="{StaticResource SuggestItem}"
                             SelectionChanged="Suggestions_SelectionChanged"/>
                </Grid>
            </phone:PivotItem>

            <!-- posts -->
            <phone:PivotItem x:Name="PostsItem" Header="posts" Margin="0,8,0,0">
                <!-- PostsRoot: когда постов нет, переключатель страниц переносится сюда, вниз -->
                <Grid x:Name="PostsRoot">
                    <ScrollViewer x:Name="PostsScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                        <StackPanel x:Name="PostsStack">
                            <Border Height="7"/>

                            <ItemsControl x:Name="PostsGrid"
                                          HorizontalAlignment="Center"
                                          ItemTemplate="{StaticResource GridItem}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>

                            <StackPanel x:Name="PagerRoot" Margin="0,12,0,36" Visibility="Collapsed">
                                <!-- номера страниц -->
                                <Grid x:Name="PagerGrid"/>

                                <!-- << < > >> -->
                                <Grid x:Name="NavGrid" Margin="0,2,0,0"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PageBox" FontSize="22">
                                        <TextBox.InputScope>
                                            <InputScope>
                                                <InputScopeName NameValue="Number"/>
                                            </InputScope>
                                        </TextBox.InputScope>
                                    </TextBox>

                                    <Button Grid.Column="1" Style="{StaticResource PageRoundButton}"
                                            Click="Go_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- нет связи с сервером: как заглушка в избранном; тап — повторить -->
                    <StackPanel x:Name="LostPanel" Visibility="Collapsed"
                                Background="Transparent" Tap="Lost_Tap"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="40,0,40,60">
                        <Image Source="/Assets/Icons/lost_connect.png"
                               Width="120" Height="120" Stretch="Uniform"/>
                        <TextBlock Text="No connection to the server. Tap to try again."
                                   FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>

                    <!-- ничего не найдено или всё скрыто блэклистом -->
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="40,0,40,60" IsHitTestVisible="False">
                        <Image Source="/Assets/Icons/no_image.png"
                               Width="120" Height="120" Stretch="Uniform"/>
                        <TextBlock x:Name="EmptyText" Text="Nothing found"
                                   FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Grid>
            </phone:PivotItem>

            <!-- favourites -->
            <phone:PivotItem x:Name="FavItem" Header="favourites" Margin="0,8,0,0">
                <Grid>
                    <ScrollViewer x:Name="FavScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                        <StackPanel>
                            <Border Height="7"/>
                            <ItemsControl x:Name="FavGrid"
                                          HorizontalAlignment="Center"
                                          ItemTemplate="{StaticResource GridItem}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                            <Border Height="36"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- заглушка, когда избранное пустое -->
                    <StackPanel x:Name="FavEmpty" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="40,0,40,60" IsHitTestVisible="False">
                        <Image Source="/Assets/Icons/image_multiple.png"
                               Width="120" Height="120" Stretch="Uniform"/>
                        <TextBlock Text="The images you've liked will appear here"
                                   FontSize="22" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Grid>
            </phone:PivotItem>
        </phone:Pivot>
    </Grid>
</phone:PhoneApplicationPage>